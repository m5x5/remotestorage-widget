{
  "name": "m5x5-remotestorage-widget",
  "version": "1.9.0",
  "description": "remoteStorage.js connect widget",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remotestorage/remotestorage-widget.git"
  },
  "keywords": [
    "remotestorage",
    "remotestoragejs",
    "unhosted",
    "no-backend",
    "offline-first"
  ],
  "author": "RS Contributors",
  "contributors": [],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/remotestorage/remotestorage-widget/issues"
  },
  "homepage": "https://github.com/remotestorage/remotestorage-widget#readme",
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "remotestoragejs": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-dts": "latest"
  }
}
